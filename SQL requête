DROP TABLE IF EXISTS cagnotte;
DROP TABLE IF EXISTS administrateur;
DROP TABLE IF EXISTS utilisateur;


CREATE TABLE administrateur (
    id SERIAL PRIMARY KEY,
    email VARCHAR(100) UNIQUE NOT NULL,
    motdepasse VARCHAR(100) NOT NULL,
    pincode VARCHAR(10) NOT NULL,
    login BOOLEAN DEFAULT FALSE 
);


CREATE TABLE utilisateur (
    id SERIAL PRIMARY KEY,
    nomcomplet VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    motdepasse VARCHAR(100) NOT NULL,
    telephone VARCHAR(20),
    date_inscription DATE DEFAULT CURRENT_DATE
);


CREATE TABLE cagnotte (
    id SERIAL PRIMARY KEY,
    id_utilisateur INT NOT NULL,
    montant INT NOT NULL,
    date_don DATE DEFAULT CURRENT_DATE,
    -- Contrainte de clé étrangère avec suppression en cascade
    CONSTRAINT FK_id_utilisateur FOREIGN KEY (id_utilisateur) 
        REFERENCES utilisateur(id) ON DELETE CASCADE
);

